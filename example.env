# SuperAgent 环境变量模板。首次配置时用 cp -n example.env .env 创建本地配置。
# 不要在此模板中填写真实密钥，也不要提交 .env。

# 模型：仅在使用真实 DashScope 对话模型和 RAG 向量服务时必填。
# 在 super-agent.config.json 中将 model.apiKey 设为 "${DASHSCOPE_API_KEY}"（初始化向导不输入 Key 时会生成此引用）。
# 在使用上述引用时留空，将使用 Mock 模型和 Mock 向量服务。
DASHSCOPE_API_KEY=

# 飞书：启用 Bot 长连接时，需同时填写应用 ID 和应用密钥。任一留空则仅启动 Dashboard。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Dashboard 的 HTTP 监听端口，与飞书长连接无关。默认 3000。
FEISHU_PORT=3000

# 网页搜索：可选，按需配置一个服务。两者都填写时优先使用 Tavily；都留空则无法搜索。
# Tavily API 密钥。
TAVILY_API_KEY=
# Serper API 密钥。
SERPER_API_KEY=

# Supabase：可选。当前插件仅提供 Mock 数据或操作占位结果，不会执行真实数据库请求。
# Supabase 项目地址，例如 https://your-project.supabase.co。留空使用 Mock 数据。
SUPABASE_URL=
# Supabase 项目的 API 密钥。
SUPABASE_KEY=
